# Local infrastructure, configuration, provider cache and state.
/terraform-local/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
# Credentials must never be included in the submission.
.env
.env.*

# Python test bytecode.
__pycache__/
*.pyc

.pytest_cache/

# Temporary GitHub Actions federation credentials and kubeconfig.
gha-creds-*.json
gha-kubeconfig-*

# Portable bootstrap tooling and test environment.
/flux-standalone/.bin/
/flux-standalone/.venv/
